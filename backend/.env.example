APP_NAME=HireAgent
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Ubuntu host: 127.0.0.1:3306; Windows SSH tunnel: 127.0.0.1:13306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hireagent
DB_USER=hireagent_app
DB_PASSWORD=replace-with-your-actual-app-password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=5

# Recruitment runtime (single backend worker)
MODEL_CONCURRENCY=1
UPLOAD_MAX_MB=20
UPLOAD_MAX_FILES=250
# STORAGE_DIR defaults to backend/storage; use an absolute path when overriding.

# Active backend: llama (self-hosted llama-server), dashscope, or openai.
LLM_PROVIDER=llama
# To switch to DeepSeek, set LLM_PROVIDER=deepseek and fill its key below.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT=300
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=
LLM_MODEL_NAME=qwen3.8
# Structured resume evaluation may need more output than a short chat reply.
LLAMA_MAX_TOKENS=8192
LLM_TEMPERATURE=0

# Optional cloud backend; used only when LLM_PROVIDER=dashscope/openai.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=replace-with-an-enabled-model
LLM_API_KEY=replace-with-your-key
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=300
LLM_MAX_TOKENS=8192
LLM_PAGE_CHARS=18000

# PDF import; extract full text locally with PyMuPDF.
IMPORT_CONCURRENCY=1

# Wait for old single-worker backend to release its database lock during reload.
STARTUP_LOCK_WAIT_SECONDS=65

# Whole-resume input budget; long resumes split by headings/paragraphs.
LLM_DOCUMENT_CHARS=30000

RUNTIME_LOCK_IDLE_TIMEOUT=60

RUNTIME_LOCK_HEARTBEAT_INTERVAL=10

RUNTIME_LOCK_HEARTBEAT_TIMEOUT=5

# Loguru: console + backend/logs/hireagent.log + backend/logs/errors.log
LOG_LEVEL=INFO
LOG_COLORIZE=true
LOG_ROTATION=20 MB
LOG_RETENTION=14 days
# LOG_DIR defaults to backend/logs. No resume text, API keys or model reasoning logged.

# Explicit demo mode; never sends actual meetings or notifications.
EXTERNAL_SERVICES_MOCK=false
EXTERNAL_ACTION_TIMEOUT=30

AUTH_COOKIE_SECURE=false

AUTH_SESSION_HOURS=8

AUTH_IDLE_MINUTES=30

AUTH_DOCS_ENABLED=false
