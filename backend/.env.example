APP_NAME=HireAgent
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Ubuntu host: 127.0.0.1:3306; Windows SSH tunnel: 127.0.0.1:13306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hireagent
DB_USER=hireagent_app
DB_PASSWORD=replace-with-your-actual-app-password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=5
